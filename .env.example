# Firebase Web App configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
FIREBASE_WEB_API_KEY=your_api_key_here

# Airtable server-side integrations
AIRTABLE_API_KEY=patXXXXXXXXXXXXXX
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_ATTENDANCE_TABLE_NAME=Attendance
AIRTABLE_DEVICE_TABLE_NAME=Attendance Devices
AIRTABLE_TABLE_NAME=INCIDENTS

# Optional store-capture webhook integration
STORE_CAPTURE_WEBHOOK_URL=https://your-webhook.example.com/store-capture
STORE_CAPTURE_WEBHOOK_SECRET=replace_with_a_random_secret
